---
import { Image } from 'astro:assets';
import instagram from '../assets/contacto/instagram.png';
import email from '../assets/contacto/email.png';
import GitIcon from './GitIcon.astro';

const links = [
	{ href: '#sobre-mi', label: 'sobre mí' },
	{ href: '#proyectos', label: 'proyectos' },
	{ href: '#habilidades', label: 'habilidades' },
	{ href: '#contacto', label: 'contacto' },
];
---

<header>
	<nav class="wrap" aria-label="Secciones">
		<a class="logo" href="#inicio" aria-label="Volver al inicio">JS</a>

		<div class="links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>

		<div class="icons">
			<a href="https://github.com/juancruzsb" aria-label="GitHub de Juan Cruz">
				<GitIcon class="icon" />
			</a>
			<a href="https://instagram.com/juancruz.sb" aria-label="Instagram de Juan Cruz">
				<Image class="icon" src={instagram} alt="" loading="eager" />
			</a>
			<a href="mailto:sabiojuancruz2@gmail.com" aria-label="Email de contacto">
				<Image class="icon" src={email} alt="" loading="eager" />
			</a>
		</div>
	</nav>
</header>

<style>
	/* Figma: header de 78px con la barra (64px) a 14px del borde superior */
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		height: calc(78 * var(--u));
		padding-top: calc(14 * var(--u));
		box-sizing: border-box;
	}

	nav {
		display: flex;
		align-items: center;
		height: calc(64 * var(--u));
		padding-inline: calc(12 * var(--u));
		box-sizing: border-box;
		border-radius: calc(16 * var(--u));
		background: var(--bg-dark);
		box-shadow: 0 calc(10 * var(--u)) calc(30 * var(--u)) #01141c59;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.logo {
		display: grid;
		place-items: center;
		width: calc(44 * var(--u));
		height: calc(44 * var(--u));
		border-radius: 50%;
		background: var(--white);
		color: var(--bg-dark);
		font-size: calc(13 * var(--u));
		font-weight: 800;
	}

	.links {
		display: flex;
		gap: calc(28 * var(--u));
		margin-left: auto;
		font-size: calc(13 * var(--u));
		line-height: 1.65;
		color: var(--muted);
	}

	.icons {
		display: flex;
		gap: calc(10 * var(--u));
		margin-left: calc(50 * var(--u));
	}

	.icons a {
		display: grid;
		place-items: center;
		width: calc(40 * var(--u));
		height: calc(40 * var(--u));
		color: var(--white);
		transition: opacity 0.2s;
	}

	.icons :global(.icon) {
		width: calc(20 * var(--u));
		height: calc(20 * var(--u));
	}

	.links a:hover {
		color: var(--white);
	}

	.icons a:hover {
		opacity: 0.7;
	}

	/* ---- Pantallas más angostas ---- */
	@media (max-width: 700px) {
		.links {
			display: none;
		}

		.icons {
			margin-left: auto;
		}
	}
</style>
